<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same exclusions for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="audio/" />
        <exclude domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
